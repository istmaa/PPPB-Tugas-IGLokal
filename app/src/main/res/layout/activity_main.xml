<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Title Bar -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/app_title"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Circular Profile Picture -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/circle_background"
            android:clickable="true"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_profile_picture"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAppTitle" />

        <!-- Profile Information: Username & Statistics Container -->
        <LinearLayout
            android:id="@+id/layoutProfileInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/imgProfile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgProfile"
            app:layout_constraintTop_toTopOf="@+id/imgProfile">

            <!-- Username -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/username"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Horizontal Statistics Row (Two-Tier Structure) -->
            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Statistic 1: Posts -->
                <LinearLayout
                    android:id="@+id/layoutStatPosts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPostsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/posts_count"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPostsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/posts_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Statistic 2: Followers -->
                <LinearLayout
                    android:id="@+id/layoutStatFollowers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFollowersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/followers_count"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFollowersLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/followers_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Statistic 3: Following -->
                <LinearLayout
                    android:id="@+id/layoutStatFollowing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFollowingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/following_count"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFollowingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/following_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Profile Header Barrier -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierProfileHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="imgProfile,layoutProfileInfo" />

        <!-- Bio: Profile Name -->
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:text="@string/profile_name"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierProfileHeader" />

        <!-- Bio: Details -->
        <TextView
            android:id="@+id/tvBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="16dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/bio_text"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProfileName" />

        <!-- Action Button: Edit Profile -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="36dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/btn_edit_profile"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_bg"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toStartOf="@+id/btnShareProfile"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBio" />

        <!-- Action Button: Share Profile -->
        <Button
            android:id="@+id/btnShareProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="36dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/btn_share_profile"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/button_bg"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnEditProfile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btnEditProfile"
            app:layout_constraintTop_toTopOf="@+id/btnEditProfile" />

        <!-- Section Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnEditProfile" />

        <!-- 3-Column Post Grid: Row 1, Column 1 (Kotlin) -->
        <ImageView
            android:id="@+id/imgPost1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_1"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/kotlin"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/imgPost2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <!-- 3-Column Post Grid: Row 1, Column 2 (Java) -->
        <ImageView
            android:id="@+id/imgPost2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_2"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/java"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost1"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/imgPost3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/imgPost1"
            app:layout_constraintTop_toTopOf="@+id/imgPost1" />

        <!-- 3-Column Post Grid: Row 1, Column 3 (Python) -->
        <ImageView
            android:id="@+id/imgPost3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="1dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_3"
            android:padding="22dp"
            android:scaleType="centerInside"
            android:src="@drawable/python"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost1"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/imgPost2"
            app:layout_constraintTop_toTopOf="@+id/imgPost1" />

        <!-- 3-Column Post Grid: Row 2, Column 1 (HTML) -->
        <ImageView
            android:id="@+id/imgPost4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_4"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/html"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost1"
            app:layout_constraintStart_toStartOf="@+id/imgPost1"
            app:layout_constraintTop_toBottomOf="@+id/imgPost1" />

        <!-- 3-Column Post Grid: Row 2, Column 2 (MySQL) -->
        <ImageView
            android:id="@+id/imgPost5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_5"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/mysql"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost4"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost2"
            app:layout_constraintStart_toStartOf="@+id/imgPost2"
            app:layout_constraintTop_toTopOf="@+id/imgPost4" />

        <!-- 3-Column Post Grid: Row 2, Column 3 (React) -->
        <ImageView
            android:id="@+id/imgPost6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_6"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/react"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost4"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost3"
            app:layout_constraintStart_toStartOf="@+id/imgPost3"
            app:layout_constraintTop_toTopOf="@+id/imgPost4" />

        <!-- 3-Column Post Grid: Row 3, Column 1 (TypeScript) -->
        <ImageView
            android:id="@+id/imgPost7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_7"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ts"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost1"
            app:layout_constraintStart_toStartOf="@+id/imgPost1"
            app:layout_constraintTop_toBottomOf="@+id/imgPost4" />

        <!-- 3-Column Post Grid: Row 3, Column 2 (Godot) -->
        <ImageView
            android:id="@+id/imgPost8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_8"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/godot"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost7"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost2"
            app:layout_constraintStart_toStartOf="@+id/imgPost2"
            app:layout_constraintTop_toTopOf="@+id/imgPost7" />

        <!-- 3-Column Post Grid: Row 3, Column 3 (JavaScript) -->
        <ImageView
            android:id="@+id/imgPost9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_9"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/js"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost7"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost3"
            app:layout_constraintStart_toStartOf="@+id/imgPost3"
            app:layout_constraintTop_toTopOf="@+id/imgPost7" />

        <!-- 3-Column Post Grid: Row 4, Column 1 (Next.js) -->
        <ImageView
            android:id="@+id/imgPost10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_10"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/nextjs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost1"
            app:layout_constraintStart_toStartOf="@+id/imgPost1"
            app:layout_constraintTop_toBottomOf="@+id/imgPost7"
            app:layout_constraintVertical_bias="0.0" />

        <!-- 3-Column Post Grid: Row 4, Column 2 (CSS) -->
        <ImageView
            android:id="@+id/imgPost11"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_11"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/css"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost10"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost2"
            app:layout_constraintStart_toStartOf="@+id/imgPost2"
            app:layout_constraintTop_toTopOf="@+id/imgPost10" />

        <!-- 3-Column Post Grid: Row 4, Column 3 (PHP) -->
        <ImageView
            android:id="@+id/imgPost12"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/post_cell_border"
            android:contentDescription="@string/cd_post_12"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/php"
            app:layout_constraintBottom_toBottomOf="@+id/imgPost10"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/imgPost3"
            app:layout_constraintStart_toStartOf="@+id/imgPost3"
            app:layout_constraintTop_toTopOf="@+id/imgPost10" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>